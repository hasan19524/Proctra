# ---------------------------------------------------------------------------
# Procto — environment template.
# Usage:  cp .env.example .env   then adjust values.
# This file is committed; `.env` is git-ignored and never committed.
#
# NOTE on ports (see DECISIONS.md D10): local ports are offset to coexist with
# other projects on this machine — API 8001, web 3001, Postgres 5434, Redis 6380.
# ---------------------------------------------------------------------------

# ---- Runtime -------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=procto
POSTGRES_PASSWORD=procto
POSTGRES_DB=procto
# Used by the backend (native run connects to the mapped host port 5434):
DATABASE_URL=postgresql+asyncpg://procto:procto@localhost:5434/procto

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0

# ---- Auth / sessions -----------------------------------------------------
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-secret-key-replace-me-in-production-0000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- LiveKit (SFU) -------------------------------------------------------
# MUST match `keys:` in livekit/livekit.yaml
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=procto-dev-key
LIVEKIT_API_SECRET=procto-dev-secret

# ---- CORS ----------------------------------------------------------------
# JSON list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
FRONTEND_URL=http://localhost:3001

# ---- Frontend (inlined at build time, must be NEXT_PUBLIC_*) -------------
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# ---- Object storage (DECISIONS.md D24) ------------------------------------
# Development & tests: MinIO from Docker Compose (`docker compose up -d minio`).
# The bucket is created automatically on first upload.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=procto
MINIO_SECURE=false
# Evidence/screenshot retention (days until automatic cleanup; 0 = keep forever).
# Files under a legal hold are never purged.
STORAGE_RETENTION_DAYS=90
# Lifetime of short-lived signed object URLs (seconds, clamped to 10..3600).
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Hours between background retention sweeps (0 disables the sweeper).
STORAGE_CLEANUP_INTERVAL_HOURS=6
#
# Production (Cloudflare R2) goes in .env.prod — the backend refuses to start
# with STORAGE_PROVIDER=minio when APP_ENV=production:
#   STORAGE_PROVIDER=r2
#   R2_ACCOUNT_ID=<cloudflare account id>
#   R2_ACCESS_KEY_ID=<r2 api token id>
#   R2_SECRET_ACCESS_KEY=<r2 api token secret>
#   R2_BUCKET=procto-evidence
