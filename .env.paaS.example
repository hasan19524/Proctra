# Proctra — free-PaaS fill-in template (D26 / DEPLOYMENT_PAAS.md)
#
# HOW: copy to `.env.paaS` (gitignored — NEVER commit it), fill values as you create
# accounts, then paste each BLOCK into the matching dashboard:
#   [Render] block  -> Render service → Environment
#   [Vercel] block  → Vercel project → Settings → Environment Variables
#   (Supabase/Upstash/LiveKit/B2 values feed INTO the Render block — they have no env UI
#    of their own for us; UptimeRobot needs a URL, not env vars.)

# ============================ [Render] backend ==============================
APP_ENV=production
APP_DEBUG=false
# 64-char random: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Supabase → session pooler (IPv4, port 5432), user = postgres.<project-ref>, sslmode required
DATABASE_URL=postgresql+asyncpg://postgres.:@.supabase.com:5432/postgres?sslmode=require

# Upstash → Redis protocol URL (rediss:// = TLS)
REDIS_URL=rediss://default:@.upstash.io:6379

# LiveKit Cloud → Project Settings (Build plan, no card)
LIVEKIT_URL=wss://.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Origin allow-list: your Vercel domain (also covers the WebSocket origin check)
FRONTEND_URL=https://.vercel.app
BACKEND_CORS_ORIGINS=https://.vercel.app

# Hardening (optional; empty = no Host check). Include both hosts behind the proxy:
# TRUSTED_HOSTS=.vercel.app,.onrender.com

# Optional overrides (defaults shown in DEPLOYMENT_PAAS.md §2.2 — usually leave unset):
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# STORAGE_RETENTION_DAYS=90
# STORAGE_SIGNED_URL_TTL_SECONDS=300
# STORAGE_CLEANUP_INTERVAL_HOURS=6

# Storage — Backblaze B2 (activates when the §3.2 storage code change lands)
# STORAGE_PROVIDER=b2
# B2_ENDPOINT=https://s3..backblazeb2.com
# B2_REGION=
# B2_ACCESS_KEY_ID=
# B2_SECRET_ACCESS_KEY=
# B2_BUCKET=procto-evidence

# ============================ [Vercel] frontend =============================
# Scope: Build & Runtime. Root Directory = frontend/
API_INTERNAL_URL=https://.onrender.com
NEXT_PUBLIC_WS_URL=wss://.onrender.com

# ============================ [UptimeRobot] =================================
# Monitor: https://<render-name>.onrender.com/api/health   interval 5 min
# (never /robots.txt — Render intercepts it while asleep)
